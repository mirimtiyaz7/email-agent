# Copy this file to ".env" and fill in your values. Never share the .env file.

# Free key from aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_gemini_key_here

# Optional: change if the default model name stops working
GEMINI_MODEL=gemini-2.5-flash

# Only needed for --imap mode (use a TEST email account)
IMAP_HOST=imap.gmail.com
EMAIL_USER=yourtest@gmail.com
EMAIL_PASS=your_16_char_app_password

# Optional: how many unread emails to read
MAX_EMAILS=10
